# --- Big Two Arena configuration ---
# Copy to `.env` for local development. On your hosting platform, set these as
# environment variables / secrets instead.

# Port the server listens on. Render injects its own PORT automatically.
PORT=3000

# Production mode serves the built SPA from dist/ instead of the Vite dev server.
NODE_ENV=development

# MongoDB connection string. Use a managed MongoDB (e.g. Atlas) in production —
# rooms are persisted here so games survive restarts.
MONGODB_URI="mongodb://localhost:27017/big-two-arena"

# How long (seconds) an abandoned room lives in the database before it expires.
ROOM_TTL_SECONDS=86400

# --- AI Studio / legacy (not required for this app to run) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
